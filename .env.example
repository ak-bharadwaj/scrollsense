# ==============================================================================
# ScrollSense Environment Configuration Template
# ==============================================================================

# Google AI Studio Gemini Free Tier Integration
# Get your free API key at: https://aistudio.google.com/
# (No Google Cloud Billing or credit card required)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional: LLM Timeout in seconds (default: 15.0)
SCROLLSENSE_LLM_TIMEOUT=15.0

# Optional: Explicit CORS Allowed Origins for Production Frontend
# SCROLLSENSE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
